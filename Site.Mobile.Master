<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Mobile.master.cs" Inherits="MWM_Assignment_New.Site_Mobile" %>
<%@ Register Src="~/ViewSwitcher.ascx" TagPrefix="friendlyUrls" TagName="ViewSwitcher" %>

<!DOCTYPE html>
<html lang="en" class="h-100">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Silver Shoal | Sardines &amp; Canned Fish</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;700&family=Young+Serif&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="<%= ResolveUrl("~/Content/Site.css") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder runat="server" ID="head" />
</head>
<body class="d-flex flex-column h-100">
    <form id="form1" runat="server" class="site-shell">
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top py-3 site-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href='<%= ResolveUrl("~/Default.aspx") %>'>
                    <i class="bi bi-water me-2"></i>Silver Shoal
                </a>
            </div>
        </nav>

        <main class="site-main flex-shrink-0 pb-5">
            <asp:ContentPlaceHolder runat="server" ID="FeaturedContent" />
            <asp:ContentPlaceHolder runat="server" ID="MainContent" />
        </main>

        <footer class="footer mt-auto py-4 site-footer">
            <div class="container text-center">
                <p class="text-muted mb-2">
                    &copy; 2026 <strong>Silver Shoal</strong>. Packed with personality.
                </p>
                <friendlyUrls:ViewSwitcher runat="server" />
            </div>
        </footer>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
